SELECT
  TESTROW.CADENCELIBRARY,
  TESTROW.TESTROWNAME,
  TESTSTRUCTURE.TESTSTRUCTNAME,
  TESTSTRUCTURE.TESTSTRUCTCOMMENT,
  STRUCTURETEMPLATE.TEMPLATENAME,
  STRUCTURETEMPLATE.CATEGORY,
  TESTSTRUCTUREPARAMETERS.PARAMETERNAME,
  TESTSTRUCTUREPARAMETERS.PARAMETERVALUE,
  TESTSTRUCTURE.TESTSTRUCTID,
  TESTROWHOOKUP.TERMINALNAME,
  TESTROWHOOKUP.PADNAME
FROM
  TESTROW,
  TESTSTRUCTURE,
  STRUCTURETEMPLATE,
  TESTSTRUCTUREPARAMETERS,
  TESTROWHOOKUP
WHERE
  ( TESTROW.TESTROWID=TESTSTRUCTURE.TESTROWID(+)  )
  AND
  ( TESTROWHOOKUP.TESTROWID=TESTSTRUCTURE.TESTROWID(+)  )
  AND  ( TESTSTRUCTURE.TESTSTRUCTID=TESTSTRUCTUREPARAMETERS.TESTSTRUCTID(+)  )
  AND  ( TESTROWHOOKUP.TESTSTRUCTUREID=TESTSTRUCTUREPARAMETERS.TESTSTRUCTID(+)  )
  AND  ( TESTSTRUCTURE.TSTEMPLATEID=STRUCTURETEMPLATE.TEMPLATEID  )
  AND  ( TESTROW.LATESTFLAG='1'  )
  --AND  ( STRUCTURETEMPLATE.LATESTFLAG='1'  )
  and TESTROW.STATUS = 9
  AND  
  (
   (TESTROW.TESTROWNAME  LIKE ('x80%') OR TESTROW.TESTROWNAME  LIKE ('1280%'))
   AND
   STRUCTURETEMPLATE.TEMPLATENAME  IN ( 'MOS_XSTR_X80C' ,  'MOS_PFT_DENSE_X80C' )
   --AND 
  -- (STRUCTURETEMPLATE.TEMPLATENAME<> 'CTM_GNAC_X78E' AND STRUCTURETEMPLATE.TEMPLATENAME<> 'BE_PROBECHK_SL_X78E')
   AND
   (TESTSTRUCTUREPARAMETERS.PARAMETERNAME  ='zone' OR TESTSTRUCTUREPARAMETERS.PARAMETERNAME ='bitcell'  OR TESTSTRUCTUREPARAMETERS.PARAMETERNAME ='cellName'  OR TESTSTRUCTUREPARAMETERS.PARAMETERNAME ='libName' OR TESTSTRUCTUREPARAMETERS.PARAMETERNAME ='cellLibrary'  )
  AND TESTROWHOOKUP.PADNAME is not null

  )
