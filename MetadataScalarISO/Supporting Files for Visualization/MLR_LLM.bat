@echo off
REM ===========================================================================
REM  MLR_Generator_SelfContained.bat
REM  A SINGLE self-contained launcher. Everything (GUI + engine + default CSVs)
REM  is embedded below as base64. No other files are needed in this folder.
REM
REM  On run it: finds a Python with tkinter, extracts the embedded app to a
REM  UNIQUE temp folder, launches the GUI (windowed), WAITS for it to close,
REM  then AUTO-CLEANS the temp folder. Requires Python 3.9-3.13 with tkinter.
REM
REM  Force a specific Python:   set PYTHON=py -3.12  &  this.bat
REM ===========================================================================
REM  NOTE: Delayed expansion is intentionally NOT enabled (cmd would corrupt the
REM  embedded PowerShell around '!'). The PowerShell also avoids '!' (uses -not).
setlocal EnableExtensions
cd /d "%~dp0"

set "SELF=%~f0"
set "DEST=%TEMP%\MLR_Generator_%RANDOM%%RANDOM%"

REM --- 1) Find a Python that HAS tkinter -------------------------------------
set "PY="
if defined PYTHON ( call :has_tk "%PYTHON%" && set "PY=%PYTHON%" )
if not defined PY ( call :has_tk "python"   && set "PY=python" )
if not defined PY ( call :has_tk "py -3.12" && set "PY=py -3.12" )
if not defined PY ( call :has_tk "py -3.11" && set "PY=py -3.11" )
if not defined PY ( call :has_tk "py -3.10" && set "PY=py -3.10" )
if not defined PY ( call :has_tk "py -3.13" && set "PY=py -3.13" )
if not defined PY ( call :has_tk "py -3.9"  && set "PY=py -3.9" )
if not defined PY ( call :has_tk "py -3"    && set "PY=py -3" )
if not defined PY ( call :has_tk "python3"  && set "PY=python3" )

if not defined PY (
    echo.
    echo ============================================================
    echo  Could not find a Python with tkinter ^(the GUI toolkit^).
    echo    1^) Install Python 3.12 from python.org and CHECK
    echo       "tcl/tk and IDLE" and "Add to PATH" during setup.
    echo    2^) Or force one:   set PYTHON=py -3.12  ^&  "%~nx0"
    echo    3^) Verify:         py -3.12 -m tkinter
    echo ============================================================
    echo.
    pause
    exit /b 1
)

REM --- 2) Extract the embedded payloads to %DEST% ---------------------------
if not exist "%DEST%" mkdir "%DEST%"
echo Extracting embedded app to "%DEST%" ...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$d=$env:DEST; if(-not(Test-Path $d)){New-Item -ItemType Directory -Path $d > $null}; foreach($l in [IO.File]::ReadLines($env:SELF)){ if($l.StartsWith('::DATA::')){ $r=$l.Substring(8); $i=$r.IndexOf([char]124); $n=$r.Substring(0,$i); $b=$r.Substring($i+1); [IO.File]::WriteAllBytes((Join-Path $d $n),[Convert]::FromBase64String($b)); } }"
if errorlevel 1 (
    echo ERROR: extraction failed. Ensure PowerShell is available.
    pause
    exit /b 1
)

REM --- 3) Launch the GUI, WAIT for it to close, then AUTO-CLEAN ---------------
set "WPY=%PY%"
if /I "%PY%"=="python"  set "WPY=pythonw"
if /I "%PY%"=="python3" set "WPY=pythonw"
if /I "%PY:~0,3%"=="py " set "WPY=pyw %PY:~3%"
%WPY% -c "import tkinter" >nul 2>&1 || set "WPY=%PY%"

echo Launching MLR Generator with:  %WPY%
echo (This window waits until you close the app, then cleans up temporary files.)
start "" /wait %WPY% "%DEST%\mlr_gui.py"

echo Cleaning up temporary files...
rmdir /s /q "%DEST%" 2>nul
exit /b 0

REM ---------------------------------------------------------------------------
:has_tk
%~1 -c "import tkinter" >nul 2>&1
exit /b %errorlevel%

REM ===========================================================================
REM  EMBEDDED PAYLOADS BELOW  (base64; never executed -- cmd stops at exit /b)
REM ===========================================================================
::DATA::mlr_gui.py|
::DATA::claude_mlr_generator.py|
::DATA::MLR_Decoder.csv|
::DATA::MLR_Mini.csv|
::DATA::MLR28_PadConfig.csv|
